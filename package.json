{
  "name": "aiflow-official-codex-probe",
  "displayName": "Aiflow Official Codex Worker",
  "description": "Version-gated reusable worker for the official Codex VS Code extension.",
  "version": "0.0.1",
  "private": true,
  "publisher": "local-aiflow",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiflow.runOfficialCodex",
    "onCommand:aiflow.runClipboardOfficialCodex",
    "onCommand:aiflow.runGitImplementation",
    "onCommand:aiflow.runClipboardGitImplementation",
    "onCommand:aiflow.cancelActiveOfficialCodexRun",
    "onCommand:aiflow.runOfficialCodexProbe",
    "onCommand:aiflow.cancelOfficialCodexProbe",
    "onCommand:aiflow.pairBrowserBridge",
    "onCommand:aiflow.revokeBrowserBridge",
    "onCommand:aiflow.showBrowserBridgeStatus",
    "onCommand:aiflow.sendSyntheticReviewEnvelope",
    "onCommand:aiflow.showLatestBrowserReviewDecision"
    ,"onCommand:aiflow.sendLatestGitResultToBrowserForReview"
    ,"onCommand:aiflow.runLatestBrowserReviewDecision"
    ,"onCommand:aiflow.showLatestBrowserReviewExecution"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiflow.runClipboardOfficialCodex",
        "title": "Aiflow: Run Clipboard Prompt Through Official Codex"
      },
      {
        "command": "aiflow.runClipboardGitImplementation",
        "title": "Aiflow: Run Clipboard Implementation and Verify Git Delivery"
      },
      {
        "command": "aiflow.cancelActiveOfficialCodexRun",
        "title": "Aiflow: Cancel Active Official Codex Run"
      },
      {
        "command": "aiflow.runOfficialCodexProbe",
        "title": "Run Official Codex Probe",
        "category": "Aiflow"
      },
      {
        "command": "aiflow.cancelOfficialCodexProbe",
        "title": "Cancel Official Codex Probe",
        "category": "Aiflow"
      },
      {
        "command": "aiflow.pairBrowserBridge",
        "title": "Aiflow: Pair Browser Bridge"
      },
      {
        "command": "aiflow.revokeBrowserBridge",
        "title": "Aiflow: Revoke Browser Pairing"
      },
      {
        "command": "aiflow.showBrowserBridgeStatus",
        "title": "Aiflow: Show Browser Bridge Status"
      },
      {
        "command": "aiflow.sendSyntheticReviewEnvelope",
        "title": "Aiflow: Send Synthetic Review Envelope to Browser"
      },
      {
        "command": "aiflow.showLatestBrowserReviewDecision",
        "title": "Aiflow: Show Latest Browser Review Decision"
      },
      {
        "command": "aiflow.sendLatestGitResultToBrowserForReview",
        "title": "Aiflow: Send Latest Git Result to Browser for Review"
      },
      {
        "command": "aiflow.runLatestBrowserReviewDecision",
        "title": "Aiflow: Run Latest Browser Review Decision"
      },
      {
        "command": "aiflow.showLatestBrowserReviewExecution",
        "title": "Aiflow: Show Latest Browser Review Execution"
      }
    ],
    "configuration": {
      "title": "Aiflow Official Codex",
      "properties": {
        "aiflow.officialCodex.realTurnTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 3,
          "maximum": 240,
          "description": "Maximum duration in minutes for one real Official Codex turn."
        },
        "aiflow.browserBridge.port": {
          "type": "integer",
          "default": 47323,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Loopback port for the authenticated Aiflow Browser Bridge."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test dist/test/*.test.js browser/aiflow-chatgpt-bridge/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
